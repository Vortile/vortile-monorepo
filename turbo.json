{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local"],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_PATH",
    "GEMINI_API_KEY",
    "GOOGLE_API_KEY",
    "MCP_SERVER_PORT",
    "WHATSAPP_VERIFY_TOKEN",
    "ELEVENLABS_API_KEY",
    "ELEVEN_API_KEY",
    "NEXT_PUBLIC_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@vortile/database#build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "@vortile/mcp#build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "mcp-server#build": {
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "start": {
      "persistent": true,
      "cache": false
    },
    "test": {
      "cache": false
    },
    "lint": {
      "cache": false
    }
  }
}
