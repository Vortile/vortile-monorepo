{
  "name": "vortile-monorepo",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --filter admin dev",
    "start": "pnpm --filter admin start",
    "test": "pnpm --filter admin test",
    "lint": "eslint .",
    "db:migrate": "pnpm --filter @vortile/database migrate",
    "db:seed": "pnpm --filter @vortile/database seed",
    "clean": "pnpm -r --parallel exec rm -rf node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^15.4.1",
    "@types/node": "20.9.0",
    "@types/pluralize": "^0.0.33",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.31.0",
    "eslint-config-next": "16.0.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-config-turbo": "^2.6.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "turbo": "^2.6.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.37.0"
  },
  "packageManager": "pnpm@10.11.0",
  "overrides": {
    "drizzle-orm": "0.30.10",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2"
  }
}
